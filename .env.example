# Copy this file to .env and fill in real values. .env is gitignored.

# One static token you make up yourself - the Android app sends this in
# the Authorization header on every request. Treat it like a password.
AUTH_TOKEN=change-me-to-a-long-random-string

# Judge0 via RapidAPI - https://rapidapi.com/judge0-official/api/judge0-ce
# Sign up, subscribe to the free tier, copy your key from the RapidAPI dashboard
JUDGE0_API_KEY=your-rapidapi-key-here
JUDGE0_HOST=judge0-ce.p.rapidapi.com
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com

# Groq - free tier, no credit card - https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

PORT=3000
